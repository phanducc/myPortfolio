{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "worker.js",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-06-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
